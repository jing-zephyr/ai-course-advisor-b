# 大模型配置（LLM_API_KEY 必填，其余有默认值）
# 默认使用 DeepSeek（platform.deepseek.com），可替换为任何 OpenAI 兼容端点（智谱GLM/通义/Moonshot 等）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 本地服务端口（可选，默认 3000）
# PORT=3000

# 演示级鉴权（双入口登录）
# ADMIN_PASSWORD：技术人员入口口令，不配置则该入口关闭；用户入口免密
# ADMIN_PASSWORD=your_admin_password_here
# AUTH_SECRET：令牌签名密钥（可选，缺省由服务端密钥派生）
# AUTH_SECRET=your_random_secret_here
